{
    "name": "wpeasy/bricks-static",
    "description": "Publish your WordPress site as static HTML over SFTP/FTP, HTTPS or Cloudflare. Bricks-aware; works with any WordPress content.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "BRXProd",
            "homepage": "https://brxprod.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "phpseclib/phpseclib": "~3.0"
    },
    "autoload": {
        "psr-4": {
            "WPEasy\\BricksStatic\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "support": {
        "forum": "https://wordpress.org/support/plugin/bricks-static/",
        "source": "https://github.com/wpeasy/bricks-static"
    }
}
