<?xml version="1.0"?>
<ruleset name="Bricks Static — Security">
    <description>
        Security-focused PHPCS ruleset for Bricks Static.
        Run `phpcs` (auto-discovers this file) from the plugin root.
        For a broader best-practice pass, run `phpcs --standard=WordPress-Extra`.
    </description>

    <!-- Scan the plugin's PHP only. -->
    <file>bricks-static.php</file>
    <file>uninstall.php</file>
    <file>src</file>

    <!-- Never scan bundled deps, build output, source assets or wp.org art. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/assets/dist/*</exclude-pattern>
    <exclude-pattern>*/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>*/src-svelte/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/><!-- show sniff codes (s) + progress (p) -->
    <arg name="parallel" value="8"/>

    <!-- Output escaping, nonce/authorization, input sanitization, safe redirects, menu slug. -->
    <rule ref="WordPress.Security">
        <!-- Exception messages are thrown/caught/logged, never echoed to the
             browser (REST returns them JSON-encoded). The sniff can't tell a
             throw from output, so this sub-rule is pure noise here. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>

    <!-- SQL safety: $wpdb->prepare(), placeholder correctness, direct-query review. -->
    <rule ref="WordPress.DB"/>

    <!-- Dangerous/discouraged PHP: eval(), create_function(), unserialize() of input, etc. -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>

    <!-- Lets the input/escaping sniffs reason about version-gated core APIs. -->
    <config name="minimum_supported_wp_version" value="6.5"/>
</ruleset>
