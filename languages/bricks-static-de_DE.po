msgstr "%d konnten nicht einbezogen werden (Gratis-Limit erreicht)."

#: src/Support/I18n.php:114
msgid "Generate and serve static HTML versions of your site for performance."
msgstr "Statische HTML-Versionen Ihrer Website generieren und ausliefern."

#: src/Support/I18n.php:115
msgid "Another plugin by"
msgstr "Ein weiteres Plugin von"

#: src/Support/I18n.php:116
msgid "You're on the free version of Bricks Static"
msgstr "Sie nutzen die kostenlose Version von Bricks Static"

#: src/Support/I18n.php:117
msgid "Upgrade to Pro"
msgstr "Auf Pro upgraden"

#: src/Support/I18n.php:118
msgid "Free — this plugin"
msgstr "Kostenlos — dieses Plugin"

#: src/Support/I18n.php:119
msgid "Pro — add-on"
msgstr "Pro — Add-on"

#. translators: %d is the page limit.
#: src/Support/I18n.php:121
#, php-format
msgid "Static generation — up to %d pages per sync"
msgstr "Statische Generierung — bis zu %d Seiten pro Synchronisation"

#: src/Support/I18n.php:122
msgid "1 destination (SFTP / FTP / FTPS)"
msgstr "1 Ziel (SFTP / FTP / FTPS)"

