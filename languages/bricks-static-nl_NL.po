msgstr "alle ingeschakelde bestemmingen"

#: src/Support/I18n.php:161
msgid "the destination"
msgstr "de bestemming"

#: src/Support/I18n.php:162
msgid ""
"Reset the push record for all destinations? The next Sync will re-upload "
"everything."
msgstr ""
"Het pushrecord voor alle bestemmingen resetten? De volgende synchronisatie "
"uploadt alles opnieuw."

#: src/Support/I18n.php:163
msgid "Destination"
msgstr "Bestemming"

#. translators: %d is the new destination's number.
#: src/Support/I18n.php:165
#, php-format
msgid "Destination %d"
