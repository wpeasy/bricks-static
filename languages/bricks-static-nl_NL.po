msgstr "Export voorbereiden… %d bestanden."

#: src/Export/ExportRunner.php:238
msgid ""
"Gzip is not available on this server (the PHP zlib extension is missing) — "
"the export will not include .gz files."
msgstr ""
"Gzip is niet beschikbaar op deze server (de PHP-extensie zlib ontbreekt) — "
"de export bevat geen .gz-bestanden."

#. translators: 1: files packaged so far, 2: total files.
#: src/Export/ExportRunner.php:265 src/Export/ExportRunner.php:327
#, php-format
msgid "Packaging… %1$d/%2$d files."
msgstr "Inpakken… %1$d/%2$d bestanden."

#. translators: 1: files gzipped so far, 2: total files to gzip.
#: src/Export/ExportRunner.php:275
#, php-format
msgid "Creating gzip files… %1$d/%2$d."
msgstr "Gzip-bestanden maken… %1$d/%2$d."

