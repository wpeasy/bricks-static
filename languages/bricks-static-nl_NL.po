msgstr "U gebruikt de gratis versie van Bricks Static"

#: src/Support/I18n.php:117
msgid "Upgrade to Pro"
msgstr "Upgraden naar Pro"

#: src/Support/I18n.php:118
msgid "Free — this plugin"
msgstr "Gratis — deze plugin"

#: src/Support/I18n.php:119
msgid "Pro — add-on"
msgstr "Pro — add-on"

#. translators: %d is the page limit.
