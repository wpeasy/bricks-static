msgstr "Gratuito — este complemento"

#: src/Support/I18n.php:119
msgid "Pro — add-on"
msgstr "Pro — complemento adicional"

#. translators: %d is the page limit.
#: src/Support/I18n.php:121
#, php-format
msgid "Static generation — up to %d pages per sync"
msgstr "Generación estática — hasta %d páginas por sincronización"

#: src/Support/I18n.php:122
