msgstr "<strong>Destinos</strong> ilimitados + sincronizar todos"

#: src/Support/I18n.php:129
msgid "Media, Links & Videos replacements"
msgstr "Sustituciones de medios, enlaces y vídeos"

#: src/Support/I18n.php:130
