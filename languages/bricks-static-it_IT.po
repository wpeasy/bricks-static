msgstr "Sincronizzazione…"

#: src/Support/I18n.php:84
msgid "Publish this page to sync it."
msgstr "Pubblica questa pagina per sincronizzarla."

#: src/Support/I18n.php:85
msgid "Enable a destination to sync this page."
msgstr "Abilita una destinazione per sincronizzare questa pagina."

#: src/Support/I18n.php:86 src/Support/I18n.php:356
