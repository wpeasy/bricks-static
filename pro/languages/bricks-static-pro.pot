#: src/Licensing/LicenseSettings.php:375
msgid "Default WordPress security keys detected"
msgstr ""

#: src/Licensing/LicenseSettings.php:376
msgid "Your wp-config.php still contains the placeholder text that ships with a fresh WordPress install (\"put your unique phrase here\"). Bricks Static Pro encrypts your license key using these WordPress security keys — replacing the placeholder with real, randomly-generated values is strongly recommended before activating."
msgstr ""

#. translators: %s: URL to WordPress.org salt generator
#: src/Licensing/LicenseSettings.php:380
#: src/Licensing/LicenseSettings.php:401
#, php-format
msgid "Open the WordPress salt generator: <a href=\"%s\" target=\"_blank\" rel=\"noopener\">%s</a>"
msgstr ""

#: src/Licensing/LicenseSettings.php:384
#: src/Licensing/LicenseSettings.php:405
msgid "Copy the 8 lines it outputs."
msgstr ""

#: src/Licensing/LicenseSettings.php:385
msgid "Open <code>wp-config.php</code> in the root of your WordPress install and replace the existing salt block (the 8 lines starting with AUTH_KEY, SECURE_AUTH_KEY, etc.) with the new lines."
msgstr ""

#: src/Licensing/LicenseSettings.php:386
#: src/Licensing/LicenseSettings.php:407
msgid "Save the file and reload this page."
msgstr ""

#: src/Licensing/LicenseSettings.php:388
#: src/Licensing/LicenseSettings.php:409
msgid "Updating these keys logs everyone out of your site (it invalidates session cookies). No data is lost — users just need to sign in again."
msgstr ""

#: src/Licensing/LicenseSettings.php:390
#: src/Licensing/LicenseSettings.php:411
msgid "Generate WordPress Security Keys"
msgstr ""

#: src/Licensing/LicenseSettings.php:396
msgid "License activation is blocked — WordPress security keys are missing"
msgstr ""

#: src/Licensing/LicenseSettings.php:397
msgid "Your wp-config.php is missing the AUTH_KEY security constant (or it's too short). Bricks Static Pro uses this key to encrypt your license key at rest, so it's never stored in plain text in your database. Activation is paused until this is fixed."
msgstr ""

#: src/Licensing/LicenseSettings.php:406
msgid "Open <code>wp-config.php</code> in the root of your WordPress install and paste the 8 lines in (replacing any existing salt block, or adding it above the \"That's all, stop editing\" comment)."
msgstr ""

#: src/Licensing/LicenseSettings.php:419
msgid "License activation is blocked — OpenSSL PHP extension is not loaded"
msgstr ""

#: src/Licensing/LicenseSettings.php:420
msgid "Your server is missing the OpenSSL PHP extension, which Bricks Static Pro uses to encrypt your license key. The OpenSSL extension is included in PHP by default on virtually every host — it's unusual to see it disabled."
msgstr ""

#: src/Licensing/LicenseSettings.php:422
msgid "Contact your hosting provider and ask them to enable the OpenSSL PHP extension."
msgstr ""

#: src/Licensing/LicenseSettings.php:423
msgid "If you manage your own server, check that <code>extension=openssl</code> is enabled in your <code>php.ini</code> file."
msgstr ""

#: src/Licensing/LicenseSettings.php:424
msgid "Once enabled, reload this page."
msgstr ""

#: src/Licensing/LicenseSettings.php:443
msgid "Licensing instance is not available."
msgstr ""

#: src/Licensing/LicenseSettings.php:502
msgid "Learn more"
msgstr ""

#: src/Licensing/LicenseSettings.php:539
msgid "Activation is paused until the issue above is resolved."
msgstr ""

